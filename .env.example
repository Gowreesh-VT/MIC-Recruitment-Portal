# Database
MONGO_URL=mongodb://localhost:27017/mic-recruitment

# Auth (NextAuth / Auth.js)
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_URL=https://recruitments.microsoftinnovations.club
NEXT_PUBLIC_APP_URL=https://recruitments.microsoftinnovations.club

# Google OAuth
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# Turnstile / Cloudflare CAPTCHA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# SMTP Email Settings (ZeptoMail / Zoho)
SMTP_HOST=smtp.zeptomail.in
SMTP_PORT=587
SMTP_USER=emailapikey
SMTP_PASS=your_zeptomail_token_here
SMTP_FROM="Microsoft Innovations Club <noreply@microsoftinnovations.club>"
